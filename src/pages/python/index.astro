---
export const prerender = true;

import Base from '../../layouts/Base.astro';
---

<Base title="Python 实操练习" description="浏览器里直接写 Python，判分器自动打分 · Python程序设计（双语）" wide={true}>
  <div class="py-header">
    <div>
      <h1>Python 实操练习</h1>
      <div class="py-sub">在浏览器里直接写代码，判分器自动核对结果 · 进度自动保存在本浏览器</div>
    </div>
    <a class="py-link" href="/python/exam">✍️ 模拟考试</a>
    <a class="py-link" href="/courses/python">📖 课程中心</a>
  </div>

  <div class="py-layout">
    <!-- 左：模块 + 题目列表 -->
    <aside class="py-side">
      <div class="py-modules" id="moduleTabs"></div>
      <div class="py-exlist" id="exList"></div>
      <div class="py-side-foot">写完点击「运行」，全部用例通过即自动记录进度<br>题目来自各模块练习库，随本地练习自动同步</div>
    </aside>

    <!-- 右：题目 → 代码框 → 输出，三个独立面板 -->
    <section class="py-main">
      <div class="py-question" id="question">
        <div class="py-question-head">
          <span class="pq-label">📝 题目</span>
          <span class="pq-meta" id="qMeta"></span>
        </div>
        <div class="py-question-body" id="qBody">选一道题，这里显示题目描述。</div>
      </div>

      <div class="py-editor-wrap">
        <div class="py-editor-bar">
          <span class="py-editor-file" id="editorFile">ex00</span>
          <div class="py-editor-actions">
            <span class="py-runtime" id="runtimeChip" title="Python 运行时状态">运行时加载中…</span>
            <button class="py-btn" id="resetBtn" title="恢复初始代码">↺ 重置</button>
            <button class="py-btn py-btn-run" id="runBtn">▶ 运行</button>
          </div>
        </div>
        <textarea id="editor" class="py-editor" spellcheck="false" autocapitalize="off" autocomplete="off"></textarea>
      </div>

      <div class="py-output" id="output">
        <div class="py-output-hint">选一道题，补全代码，点「运行」看结果。</div>
      </div>
    </section>
  </div>

  <div class="py-footnote">覆盖 10 个模块共 151 道实操题 · 日常练习 + 模拟考试两套模式</div>
</Base>

<script>
  import { createPythonRunner } from '../../scripts/pythonRunner.js';

  const PROG_KEY = 'python-progress';
  const runner = createPythonRunner();

  const state = { modules: [], currentModule: null, currentEx: null };
  let progress = {};
  try { progress = JSON.parse(localStorage.getItem(PROG_KEY) || '{}'); } catch (e) {}
  let runtimeReady = false;

  const $ = (id) => document.getElementById(id);

  /* ── 加载练习定义 ── */
  async function loadExercises() {
    try {
      const res = await fetch('/python/exercises.json');
      state.modules = (await res.json()).modules;
    } catch (e) {
      $('output').innerHTML = '<div class="res-err">练习数据加载失败：' + e.message + '</div>';
      return;
    }
    if (!state.modules.length) {
      $('output').innerHTML = '<div class="res-err">还没有练习，先让本地项目生成 exercises.json</div>';
      return;
    }
    // 支持 ?module=03 从讲义直接定位到模块（缺省进第一个）
    const want = new URLSearchParams(location.search).get('module');
    const target = state.modules.find((m) => m.no === want) || state.modules[0];
    selectModule(target.no);
  }

  /* ── 模块标签 ── */
  function renderModules() {
    $('moduleTabs').innerHTML = state.modules.map((m) =>
      `<button class="py-mod${m.no === state.currentModule ? ' active' : ''}" data-no="${m.no}" title="${m.name}">${m.no}</button>`
    ).join('');
    $('moduleTabs').querySelectorAll('.py-mod').forEach((b) =>
      b.onclick = () => selectModule(b.dataset.no)
    );
  }

  /* ── 题目列表 ── */
  function renderList() {
    const mod = state.modules.find((m) => m.no === state.currentModule);
    $('exList').innerHTML = mod.exercises.map((e) => {
      const done = !!progress[e.id];
      return `<button class="py-ex${e.id === state.currentEx ? ' active' : ''}" data-id="${e.id}">
        <span class="py-ex-status${done ? ' done' : ''}">${done ? '✓' : ''}</span>
        <span class="py-ex-title">${e.title}</span>
        <span class="py-ex-meta">${e.minutes}′</span>
      </button>`;
    }).join('');
    $('exList').querySelectorAll('.py-ex').forEach((b) =>
      b.onclick = () => selectExercise(b.dataset.id)
    );
  }

  function selectModule(no) {
    state.currentModule = no;
    renderModules();
    const mod = state.modules.find((m) => m.no === no);
    state.currentEx = mod.exercises[0].id;
    renderList();
    loadEditor();
  }

  function selectExercise(id) {
    state.currentEx = id;
    renderList();
    loadEditor();
  }

  function currentExercise() {
    const mod = state.modules.find((m) => m.no === state.currentModule);
    return mod.exercises.find((e) => e.id === state.currentEx);
  }

  function loadEditor() {
    const ex = currentExercise();
    $('editorFile').textContent = ex.id + ' · ' + ex.title;
    $('editor').value = ex.stub;
    const done = !!progress[ex.id];
    $('qMeta').textContent = (ex.tags ? ex.tags + ' · ' : '') + ex.minutes + ' 分钟' + (done ? ' · ✓ 已完成' : ' · 未完成');
    $('qBody').textContent = ex.prompt || '补全函数/类，使所有用例通过。';
    $('output').innerHTML = '<div class="py-output-hint">补全代码，点「运行」看结果。</div>';
  }

  /* ── 运行：复用共享运行器（就绪前自动排队，9s 超时自动重置） ── */
  async function runCode() {
    const ex = currentExercise();
    if (!runner.ready) {
      $('output').innerHTML = '<div class="py-output-hint">正在加载 Python 运行时（首次约 13MB，之后浏览器缓存）…</div>';
    } else {
      $('output').innerHTML = '<div class="py-output-hint">运行中…</div>';
    }
    window._runT0 = Date.now();
    const r = await runner.grade($('editor').value, ex.tests);
    if (!r.ok || !r.json) {
      $('output').innerHTML = '<div class="res-err">' + (r.error || '运行时错误') + '</div>';
      return;
    }
    showResult(r);
  }

  function updateRuntimeChip() {
    const chip = $('runtimeChip');
    if (!chip) return; // View Transition 导航走后 DOM 已卸载
    chip.textContent = runtimeReady ? '运行时就绪' : '运行时加载中…';
    chip.classList.toggle('ready', runtimeReady);
  }

  function showResult(msg) {
    let data;
    try { data = JSON.parse(msg.json); } catch (e) {
      $('output').innerHTML = '<div class="res-err">判分结果解析失败</div>';
      return;
    }
    const secs = Math.round((Date.now() - window._runT0) / 100) / 10;
    const results = data.results || [];
    let passed = 0;
    let html = '';
    results.forEach((r, i) => {
      if (r.passed) { passed++; html += '<div class="res-ok">✓ 用例 ' + (i + 1) + ' 通过</div>'; }
      else {
        const detail = r.error ? r.error : '期望 ' + (r.expected !== undefined ? r.expected : '') + '，得到 ' + (r.got !== undefined ? r.got : '');
        html += '<div class="res-fail">✗ 用例 ' + (i + 1) + '：' + detail + '</div>';
      }
    });
    if (data.error) html += '<div class="res-err">' + data.error + '</div>';
    const verdict = data.ok
      ? '全部通过'
      : '还有用例未通过，查看 ✗ 提示后修改重试';
    html = '<div class="res-head ' + (data.ok ? 'ok' : 'fail') + '">' + verdict + ' · ' + passed + '/' + results.length + ' · ' + secs + 's</div>' + html;
    $('output').innerHTML = html;

    if (data.ok) {
      progress[state.currentEx] = 1;
      localStorage.setItem(PROG_KEY, JSON.stringify(progress));
      renderList();
    }
  }

  /* ── 初始化 ── */
  function init() {
    if (window.__pyInit) return;
    window.__pyInit = true;
    $('runBtn').onclick = runCode;
    $('resetBtn').onclick = () => { const ex = currentExercise(); $('editor').value = ex.stub; };
    runner.warmup();
    setInterval(() => { runtimeReady = runner.ready; updateRuntimeChip(); }, 400);
    loadExercises();
  }
  document.addEventListener('astro:page-load', init);
  init();
</script>

<style>
  .py-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 1.2rem;
  }
  .py-header h1 { font-size: 1.6rem; margin: 0; }
  .py-sub { font-size: 0.82rem; color: var(--text-muted); margin-top: 0.1rem; }
  .py-link {
    font-size: 0.8rem; color: var(--c-python); text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--c-python) 40%, transparent);
    padding: 0.4rem 0.8rem; border-radius: 8px; white-space: nowrap;
  }
  .py-link:hover { background: var(--c-python-glow); }

  .py-layout {
    display: grid; grid-template-columns: 250px 1fr; gap: 1rem;
    max-width: var(--max-width-wide); margin: 0 auto;
  }
  .py-side { display: flex; flex-direction: column; gap: 0.75rem; }
  .py-modules { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .py-mod {
    font-family: var(--font-mono); font-size: 0.8rem;
    padding: 0.3rem 0.65rem; border-radius: 6px;
    border: 1px solid var(--border); background: var(--bg-card);
    color: var(--text-secondary); cursor: pointer;
  }
  .py-mod.active {
    background: var(--c-python); color: #04211c; font-weight: 700; border-color: transparent;
  }
  .py-exlist {
    display: flex; flex-direction: column; gap: 0.35rem;
    max-height: 560px; overflow-y: auto;
  }
  .py-ex {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.6rem; text-align: left;
    border-radius: 8px; border: 1px solid var(--border);
    background: var(--bg-card); color: var(--text); cursor: pointer;
    font-size: 0.8rem;
  }
  .py-ex:hover { border-color: var(--c-python); }
  .py-ex.active { border-color: var(--c-python); box-shadow: 0 0 0 1px var(--c-python); }
  .py-ex-status {
    width: 16px; height: 16px; flex-shrink: 0;
    border: 1px solid var(--text-muted); border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 0.7rem; color: #04211c;
  }
  .py-ex-status.done { background: var(--c-python); border-color: var(--c-python); }
  .py-ex-title { flex: 1; }
  .py-ex-meta { font-size: 0.65rem; color: var(--text-muted); }
  .py-side-foot { font-size: 0.68rem; color: var(--text-muted); line-height: 1.6; }
  .py-side-foot code { font-family: var(--font-mono); }

  .py-main { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }

  /* 题目面板（独立于代码框） */
  .py-question {
    border: 1px solid var(--border); border-radius: 10px; overflow: hidden;
    background: var(--bg-card);
  }
  .py-question-head {
    display: flex; justify-content: space-between; align-items: center; gap: 0.6rem;
    padding: 0.45rem 0.7rem; border-bottom: 1px solid var(--border); background: var(--bg);
  }
  .pq-label { font-weight: 600; font-size: 0.8rem; color: var(--c-python); }
  .pq-meta { font-size: 0.7rem; color: var(--text-muted); font-family: var(--font-mono); }
  .py-question-body {
    padding: 0.7rem 0.9rem;
    font-size: 0.82rem; line-height: 1.7;
    white-space: pre-wrap; word-break: break-word; color: var(--text);
  }

  .py-editor-wrap {
    border: 1px solid var(--border); border-radius: 10px; overflow: hidden;
    background: var(--bg-card);
  }
  .py-editor-bar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 0.4rem 0.7rem; border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  .py-editor-file { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary); }
  .py-editor-actions { display: flex; gap: 0.4rem; align-items: center; }
  .py-runtime {
    font-size: 0.68rem; color: var(--text-muted);
    display: inline-flex; align-items: center; gap: 0.3rem;
    padding: 0.22rem 0.55rem; border-radius: 999px;
    background: var(--bg-hover); border: 1px solid var(--border); white-space: nowrap;
  }
  .py-runtime::before {
    content: ''; width: 7px; height: 7px; border-radius: 50%;
    background: #f0a43a;
  }
  .py-runtime.ready::before { background: var(--c-python); }
  .py-runtime.ready { color: var(--text-secondary); }
  .py-btn {
    font-size: 0.78rem; padding: 0.35rem 0.8rem; cursor: pointer;
    border-radius: 7px; border: 1px solid var(--border);
    background: var(--bg-card); color: var(--text);
  }
  .py-btn:hover { border-color: var(--text-muted); }
  .py-btn-run { background: var(--c-python); color: #04211c; font-weight: 700; border-color: transparent; }
  .py-btn-run:hover { box-shadow: 0 0 12px var(--c-python-glow); }
  .py-editor {
    width: 100%; height: 320px;
    padding: 0.9rem; box-sizing: border-box;
    background: var(--bg); color: var(--text);
    border: none; outline: none; resize: vertical;
    font-family: var(--font-mono); font-size: 0.82rem; line-height: 1.6;
    tab-size: 4;
  }

  .py-output {
    border: 1px solid var(--border); border-radius: 10px;
    padding: 0.9rem 1rem; min-height: 140px;
    background: var(--bg-card);
    font-family: var(--font-mono); font-size: 0.78rem; line-height: 1.7;
    white-space: pre-wrap; word-break: break-all;
  }
  .py-output-hint { color: var(--text-muted); font-family: var(--font-mono); }
  .res-head { font-weight: 700; margin-bottom: 0.4rem; }
  .res-head.ok { color: var(--c-python); }
  .res-head.fail { color: #ff6b5e; }
  .res-ok { color: var(--c-python); }
  .res-fail { color: #ffb454; }
  .res-err { color: #ff6b5e; }

  .py-footnote {
    margin-top: 1.5rem; font-size: 0.72rem; color: var(--text-muted);
  }
  .py-footnote code { font-family: var(--font-mono); }

  @media (max-width: 760px) {
    .py-layout { grid-template-columns: 1fr; }
    .py-exlist { max-height: 260px; }
  }
</style>
