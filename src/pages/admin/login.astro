---
import { verifyToken, COOKIE_NAME } from '../../lib/auth.js';
import '../../styles/admin.css';

const token = Astro.cookies.get(COOKIE_NAME)?.value;
if (token && verifyToken(token)) {
  return Astro.redirect('/admin');
}
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>登录 — 管理后台</title>
</head>
<body>
  <div class="login-shell">
    <div class="login-card">
      <div class="side-mark" style="margin:0 auto 16px">S</div>
      <h1>管理后台</h1>
      <p class="sub">登录以管理内容</p>

      <form id="loginForm">
        <div class="fg">
          <label for="username">用户名</label>
          <input type="text" id="username" name="username" required autocomplete="username">
        </div>
        <div class="fg">
          <label for="password">密码</label>
          <input type="password" id="password" name="password" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn-pri login-btn" id="loginBtn">登录</button>
        <p class="login-err" id="errorMsg" hidden>用户名或密码错误</p>
      </form>

      <a class="login-back" href="/">← 返回网站</a>
    </div>
  </div>

  <script>
    const form = document.getElementById('loginForm');
    const err = document.getElementById('errorMsg');
    const btn = document.getElementById('loginBtn');

    form.onsubmit = async (e) => {
      e.preventDefault();
      err.hidden = true;
      btn.disabled = true;
      btn.textContent = '登录中…';
      try {
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ username: form.username.value, password: form.password.value }),
        });
        if (res.ok) {
          window.location.href = '/admin';
          return;
        }
        const data = await res.json().catch(() => ({}));
        err.textContent = data.error || '用户名或密码错误';
        err.hidden = false;
      } catch (e2) {
        err.textContent = '网络异常，请重试';
        err.hidden = false;
      }
      btn.disabled = false;
      btn.textContent = '登录';
    };
  </script>
</body>
</html>

<style>
  .login-shell {
    min-height: 100vh; display: grid; place-items: center; padding: 24px;
    background:
      radial-gradient(ellipse 70% 55% at 50% 0%, rgba(88,166,255,.09), transparent 70%),
      var(--a-plane);
  }
  .login-card {
    width: 100%; max-width: 360px;
    background: var(--a-card); border: 1px solid var(--a-line);
    border-radius: var(--a-r); padding: 32px 28px 24px;
    box-shadow: 0 20px 50px rgba(0,0,0,.5);
    text-align: center;
  }
  .login-card h1 { font-size: 17px; font-weight: 600; }
  .login-card .sub { font-size: 12.5px; color: var(--a-ink-3); margin: 4px 0 24px; }
  .login-card .fg { text-align: left; margin-bottom: 16px; }
  .login-btn { width: 100%; justify-content: center; padding: 9px; margin-top: 4px; }
  .login-err {
    margin-top: 14px; font-size: 12.5px; color: var(--a-danger);
    background: rgba(248,81,73,.1); border: 1px solid rgba(248,81,73,.28);
    border-radius: var(--a-r-sm); padding: 8px 10px;
  }
  .login-back {
    display: inline-block; margin-top: 22px; font-size: 12.5px;
    color: var(--a-ink-3); text-decoration: none; transition: color .15s;
  }
  .login-back:hover { color: var(--a-ink-2); }
</style>
