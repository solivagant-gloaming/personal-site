---
import Admin from '../../layouts/Admin.astro';
---

<Admin title="内容管理" width="wide">
  <div class="hd">
    <div>
      <h1>内容管理</h1>
      <p id="countInfo">加载中…</p>
    </div>
    <a href="/admin/notes/new" class="btn btn-pri">＋ 写笔记</a>
  </div>

  <div class="split">
    <div class="tree-panel">
      <div class="tree-search">
        <input type="text" id="treeSearch" placeholder="搜索内容…">
      </div>
      <div class="tree-scroll" id="treeContainer">
        <div class="loading">加载中…</div>
      </div>
    </div>
    <div class="content-panel" id="contentPanel">
      <div class="content-empty">从左侧选择一项查看详情</div>
    </div>
  </div>

  <div class="toast" id="toast"></div>
</Admin>

<script>
  let allItems = [];
  let activeId = null;
  const expandedFolders = new Set();

  const typeIcons = { note: '📄', project: '🛠️', hobby: '🎨', quote: '💬' };
  const typeLabels = { note: '笔记', project: '项目', hobby: '爱好', quote: '拾句' };
  const typeClasses = { note: 't-note', project: 't-project', hobby: 't-hobby', quote: 't-quote' };

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.appendChild(document.createTextNode(str || ''));
    return div.innerHTML;
  }

  function escapeAttr(str) {
    return (str || '').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function buildTree(items) {
    const groups = {};
    items.forEach((n) => {
      const key = n.course || (n.type === 'project' ? '课程项目' : n.type === 'hobby' ? '爱好' : n.type === 'quote' ? '拾句' : '未分类');
      const typeKey = n.type + '::' + key;
      if (!groups[typeKey]) groups[typeKey] = { type: n.type, course: key, items: [] };
      groups[typeKey].items.push(n);
    });
    return Object.entries(groups)
      .sort((a, b) => {
        const order = { note: 0, project: 1, hobby: 2, quote: 3 };
        const ta = order[a[1].type] || 99, tb = order[b[1].type] || 99;
        return ta - tb || a[1].course.localeCompare(b[1].course);
      })
      .map(([, v]) => v);
  }

  function renderTree() {
    const container = document.getElementById('treeContainer');
    const search = document.getElementById('treeSearch').value.trim().toLowerCase();
    let filtered = allItems;
    if (search) {
      filtered = allItems.filter((n) =>
        n.title.toLowerCase().includes(search) || (n.course || '').toLowerCase().includes(search));
    }
    const tree = buildTree(filtered);

    if (tree.length === 0) {
      container.innerHTML = '<div class="tree-empty">没有内容</div>';
      return;
    }

    let html = '';
    tree.forEach((group) => {
      const key = group.type + '|' + group.course;
      const isExpanded = expandedFolders.has(key) || !!search;
      html += '<div class="tree-folder">';
      html += '<div class="tree-folder-label" data-key="' + escapeAttr(key) + '" data-type="' + group.type + '">';
      html += '<span class="icon' + (isExpanded ? ' open' : '') + '">▶</span>';
      html += '<span class="fi">' + (typeIcons[group.type] || '📄') + '</span>';
      html += '<span>' + escapeHtml(typeLabels[group.type]) + ' · ' + escapeHtml(group.course) + '</span>';
      html += '<span class="count">' + group.items.length + '</span>';
      html += '</div>';
      html += '<div class="tree-folder-children' + (isExpanded ? ' open' : '') + '">';
      group.items.forEach((n) => {
        const active = n.id === activeId ? ' active' : '';
        html += '<div class="tree-file' + active + '" data-id="' + n.id + '">';
        html += '<span class="fi">' + (typeIcons[n.type] || '📄') + '</span>';
        html += '<span class="type-badge ' + (typeClasses[n.type] || '') + '">' + (typeLabels[n.type] || n.type) + '</span>';
        html += '<span>' + escapeHtml(n.title) + '</span>';
        html += '</div>';
      });
      html += '</div></div>';
    });

    container.innerHTML = html;
    document.getElementById('countInfo').textContent = '共 ' + allItems.length + ' 项内容';
  }

  async function showItem(id) {
    activeId = id;
    const item = allItems.find((n) => n.id === id);
    if (!item) return;

    const panel = document.getElementById('contentPanel');
    let tags = '';
    try {
      tags = (Array.isArray(item.tags) ? item.tags : JSON.parse(item.tags || '[]'))
        .map((t) => '<span class="tag">' + escapeHtml(t) + '</span>').join('');
    } catch (e) { /* 标签解析失败就不显示 */ }

    const dateStr = item.created_at ? new Date(item.created_at).toLocaleString('zh-CN') : '';
    // 列表接口只给 LEFT(excerpt,200)，而且不少笔记的 excerpt 在库里就是空的
    // （以前这里读 item.content，取到的永远是 undefined，详情区一直是白的）。
    // 先用 excerpt 占位，再单独取该条全文补上。
    const preview = item.excerpt || '';
    const typeLabel = typeLabels[item.type] || item.type;
    const publicPath = item.type === 'note'
      ? '/notes/' + id
      : '/' + (item.type === 'project' ? 'projects' : item.type === 'hobby' ? 'hobbies' : 'quotes') + '/' + (item.slug || id);

    panel.innerHTML = '<div class="content-note">'
      + '<div class="content-hd">'
      + '<h2>' + escapeHtml(item.title) + '</h2>'
      + '<div class="content-meta">'
      + '<span>📂 ' + typeLabel + '</span>'
      + '<span>🏷️ ' + escapeHtml(item.course || '未分类') + '</span>'
      + '<span>🕐 ' + dateStr + '</span>'
      + (tags ? '<span>' + tags + '</span>' : '')
      + '</div></div>'
      + '<div class="content-body">'
      + '<div class="preview">' + escapeHtml(preview) + (preview.length >= 200 ? '…' : '') + '</div>'
      + '</div>'
      + '<div class="content-actions">'
      + '<a href="/admin/notes/edit/' + id + '" class="btn btn-pri">✏️ 编辑</a>'
      + '<button class="btn btn-del" id="deleteBtn" data-id="' + id + '">🗑️ 删除</button>'
      + '<a href="' + publicPath + '" target="_blank" rel="noopener" class="btn btn-sec">🔗 查看</a>'
      + '</div></div>';

    document.querySelectorAll('.tree-file').forEach((el) => el.classList.remove('active'));
    const treeFile = document.querySelector('.tree-file[data-id="' + id + '"]');
    if (treeFile) treeFile.classList.add('active');

    // 补上全文（列表接口不带 content）
    try {
      const res = await fetch('/api/notes/' + id);
      if (!res.ok || activeId !== id) return;   // 请求返回时用户可能已经点了别的条目
      const full = await res.json();
      const body = full.content || item.excerpt || '（这条内容还没有正文）';
      const pv = panel.querySelector('.preview');
      if (pv) pv.textContent = body;
    } catch (e) { /* 取不到就保留 excerpt 占位 */ }
  }

  document.addEventListener('click', (e) => {
    const folderLabel = e.target.closest('.tree-folder-label');
    if (folderLabel) {
      const key = folderLabel.dataset.key;
      const children = folderLabel.nextElementSibling;
      const icon = folderLabel.querySelector('.icon');
      if (children) {
        children.classList.toggle('open');
        icon && icon.classList.toggle('open');
        if (children.classList.contains('open')) expandedFolders.add(key);
        else expandedFolders.delete(key);
      }
      return;
    }
    const fileEl = e.target.closest('.tree-file');
    if (fileEl) {
      showItem(parseInt(fileEl.dataset.id, 10));
      renderTree();
    }
  });

  document.getElementById('treeSearch').addEventListener('input', renderTree);

  document.getElementById('contentPanel').addEventListener('click', async (e) => {
    const btn = e.target.closest('#deleteBtn');
    if (!btn) return;
    const id = parseInt(btn.dataset.id, 10);
    const item = allItems.find((n) => n.id === id);
    if (!confirm('确定删除「' + (item ? item.title : '') + '」？')) return;
    const res = await fetch('/api/notes/' + id, { method: 'DELETE' });
    if (res.ok) {
      showToast('已删除', 'ok');
      activeId = null;
      await loadData();
    } else {
      showToast('删除失败', 'err');
    }
  });

  function showToast(msg, type) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.className = 'toast ' + type + ' show';
    setTimeout(() => t.classList.remove('show'), 2000);
  }

  async function loadData() {
    const res = await fetch('/api/contents?limit=500');
    if (!res.ok) {
      document.getElementById('treeContainer').innerHTML = '<div class="tree-empty">读取失败，刷新重试</div>';
      return;
    }
    const data = await res.json();
    allItems = data.contents || [];
    renderTree();
  }

  loadData();
</script>
