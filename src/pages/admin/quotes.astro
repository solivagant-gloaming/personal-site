---
import Admin from '../../layouts/Admin.astro';
---

<Admin title="拾句投稿审核">
  <div class="hd">
    <div>
      <h1>拾句投稿审核</h1>
      <p id="countInfo">加载中…</p>
    </div>
    <div class="hd-actions">
      <button class="btn btn-sec" id="refreshBtn">刷新</button>
    </div>
  </div>

  <div id="listWrap">
    <div class="loading">加载中…</div>
  </div>

  <div class="toast" id="toast"></div>
</Admin>

<script>
  function escapeHtml(str) {
    const div = document.createElement('div');
    div.appendChild(document.createTextNode(str || ''));
    return div.innerHTML;
  }

  function readMeta(m) {
    if (!m) return {};
    if (typeof m === 'object') return m;
    try { return JSON.parse(m); } catch (e) { return {}; }
  }

  function showToast(msg, type) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.className = 'toast ' + type + ' show';
    setTimeout(() => t.classList.remove('show'), 2000);
  }

  function render(pending, publishedTotal) {
    const wrap = document.getElementById('listWrap');
    const count = document.getElementById('countInfo');

    if (!pending.length) {
      count.textContent = `已上墙 ${publishedTotal} 句，暂无待审投稿`;
      wrap.innerHTML = '<div class="empty">投稿箱是空的。<br>有人投稿、且需要你点头时，会出现在这里。</div>';
      return;
    }

    count.textContent = `${pending.length} 句待审 · 已上墙 ${publishedTotal} 句`;

    let html = '<div class="tip">通过 → 立刻出现在 <b>/quotes</b> 的弹幕里；删除 → 永久丢弃。这两个动作都不会通知投稿人。</div>';
    html += '<div class="list">';

    pending.forEach((q) => {
      const meta = readMeta(q.metadata);
      const source = meta.source || q.title || '';
      const by = meta.submitter || '';
      const at = q.created_at ? new Date(q.created_at).toLocaleString('zh-CN') : '';

      html += `<div class="card card-pad" data-id="${q.id}">`;
      html += `<div class="card-body">${escapeHtml(q.content)}</div>`;
      html += '<div class="card-meta">';
      html += `<span><b>出处</b> ${escapeHtml(source || '未填')}</span>`;
      html += `<span><b>署名</b> ${escapeHtml(by || '匿名')}</span>`;
      html += `<span><b>投于</b> ${escapeHtml(at)}</span>`;
      html += '</div>';
      html += '<div class="card-actions">';
      html += `<button class="btn btn-pri" data-act="publish" data-id="${q.id}">✓ 通过并上墙</button>`;
      html += `<button class="btn btn-del" data-act="delete" data-id="${q.id}">✕ 删除</button>`;
      html += '</div></div>';
    });

    html += '</div>';
    wrap.innerHTML = html;
  }

  async function load() {
    const res = await fetch('/api/admin/quotes', { credentials: 'same-origin' });
    if (res.status === 401) { window.location.href = '/admin/login'; return; }
    if (!res.ok) { showToast('加载失败', 'err'); return; }
    const data = await res.json();
    render(data.pending || [], data.publishedTotal || 0);
  }

  document.getElementById('listWrap').addEventListener('click', async (e) => {
    const btn = e.target.closest('button[data-act]');
    if (!btn) return;

    const id = btn.dataset.id;
    const act = btn.dataset.act;

    if (act === 'delete' && !confirm('确定删除这句投稿？此操作不可撤销。')) return;

    const card = btn.closest('.card');
    card.querySelectorAll('button').forEach((b) => { b.disabled = true; });

    try {
      const res = act === 'publish'
        ? await fetch('/api/notes/' + id, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ status: 'published' }),
          })
        : await fetch('/api/notes/' + id, { method: 'DELETE', credentials: 'same-origin' });

      if (!res.ok) throw new Error();
      showToast(act === 'publish' ? '已上墙' : '已删除', 'ok');
      card.remove();
      await load();
    } catch (err) {
      showToast(act === 'publish' ? '上墙失败' : '删除失败', 'err');
      card.querySelectorAll('button').forEach((b) => { b.disabled = false; });
    }
  });

  document.getElementById('refreshBtn').addEventListener('click', load);

  load();
</script>
