---
import Admin from '../../../../layouts/Admin.astro';
---

<Admin title="编辑笔记">
  <div class="hd">
    <div>
      <h1 id="pageTitle">编辑笔记</h1>
      <p>改动会即时保存草稿到本地，点「保存」才写回服务器</p>
    </div>
    <div class="hd-actions">
      <a href="/admin/notes" class="btn btn-sec">← 返回列表</a>
    </div>
  </div>

  <div class="card card-pad">
    <div class="fg">
      <label for="title">标题</label>
      <input type="text" id="title" placeholder="笔记标题">
    </div>

    <div class="fg">
      <label for="course">课程分类</label>
      <select id="course"><option value="">无分类</option></select>
    </div>

    <div class="fg">
      <label for="image">封面图片路径</label>
      <input type="text" id="image" placeholder="/photos/xxx.jpg">
      <div class="hint">图片放进 public/photos/ 后填路径，爱好与项目会用到</div>
    </div>

    <div class="fg">
      <label for="content">内容（Markdown）</label>
      <textarea id="content" placeholder="用 Markdown 写笔记…"></textarea>
    </div>

    <div class="fg">
      <label for="tags">标签</label>
      <input type="text" id="tags" placeholder="逗号分隔，例：操作系统, 进程管理">
    </div>

    <div class="actions">
      <button class="btn btn-pri" id="saveBtn">保存</button>
      <a href="/admin/notes" class="btn btn-sec">取消</a>
      <span class="status" id="status"></span>
    </div>
  </div>
</Admin>

<script>
  const $ = (id) => document.getElementById(id);
  const noteId = window.location.pathname.split('/').pop();
  const STORAGE_KEY = 'note_draft_edit_' + noteId;
  const AUTO_FIELDS = ['title', 'content', 'tags', 'image'];
  let saveTimer = null;

  function saveDraft() {
    const draft = {};
    AUTO_FIELDS.forEach((f) => {
      const el = $(f);
      draft[f] = el ? el.value : '';
    });
    draft.course = ($('course') || {}).value || '';
    localStorage.setItem(STORAGE_KEY, JSON.stringify(draft));
    const now = new Date();
    $('status').textContent = '草稿已保存 ' + now.getHours() + ':' + String(now.getMinutes()).padStart(2, '0');
    $('status').className = 'status';
  }

  function onDraftInput() {
    clearTimeout(saveTimer);
    saveTimer = setTimeout(saveDraft, 2000);
  }

  function tryRestoreDraft() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const draft = JSON.parse(raw);
      if (!draft.title && !draft.content) return;
      if (!confirm('检测到未保存的修改，是否恢复？\n（点“取消”丢弃草稿）')) {
        localStorage.removeItem(STORAGE_KEY);
        return;
      }
      AUTO_FIELDS.forEach((f) => {
        const el = $(f);
        if (el && draft[f]) el.value = draft[f];
      });
      const sel = $('course');
      if (draft.course) {
        const exists = Array.from(sel.options).some((o) => o.value === draft.course);
        if (!exists) {
          const o = document.createElement('option');
          o.value = draft.course;
          o.textContent = draft.course;
          sel.appendChild(o);
        }
        sel.value = draft.course;
      }
      $('status').textContent = '草稿已恢复';
    } catch (e) { /* 草稿损坏就当没有 */ }
  }

  Promise.all([
    fetch('/api/notes/' + noteId).then((r) => r.json()),
    fetch('/api/notes?limit=1').then((r) => r.json()),
  ]).then(([note, data]) => {
    if (!note || note.error) {
      $('status').textContent = '加载失败：' + ((note && note.error) || '内容不存在');
      $('status').className = 'status err';
      return;
    }

    document.title = '编辑：' + note.title + ' — 管理后台';
    $('pageTitle').textContent = '编辑：' + note.title;
    $('title').value = note.title || '';
    $('content').value = note.content || '';

    let meta = {};
    try { meta = typeof note.metadata === 'object' ? note.metadata : JSON.parse(note.metadata || '{}'); } catch (e) { /* 忽略 */ }
    if (meta.image) $('image').value = meta.image;

    const sel = $('course');
    (data.courses || []).forEach((c) => {
      const o = document.createElement('option');
      o.value = c;
      o.textContent = c;
      sel.appendChild(o);
    });
    if (note.course) sel.value = note.course;

    let tags = [];
    try { tags = Array.isArray(note.tags) ? note.tags : JSON.parse(note.tags || '[]'); } catch (e) { /* 忽略 */ }
    $('tags').value = tags.join(', ');

    AUTO_FIELDS.forEach((f) => {
      const el = $(f);
      if (el) el.addEventListener('input', onDraftInput);
    });
    sel.addEventListener('change', onDraftInput);

    tryRestoreDraft();
  }).catch(() => {
    $('status').textContent = '加载失败';
    $('status').className = 'status err';
  });

  $('saveBtn').addEventListener('click', async () => {
    const status = $('status');
    const title = $('title').value.trim();
    if (!title) {
      status.textContent = '标题不能为空';
      status.className = 'status err';
      return;
    }

    const tags = $('tags').value.split(',').map((t) => t.trim()).filter(Boolean);
    const imageVal = $('image').value.trim();

    const payload = {
      title,
      content: $('content').value,
      course: $('course').value,
      tags,
    };
    // 仅在填了图片时更新 metadata，避免覆盖项目详情等既有 metadata
    if (imageVal) payload.metadata = { image: imageVal };

    status.textContent = '保存中…';
    status.className = 'status';

    const res = await fetch('/api/notes/' + noteId, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify(payload),
    });

    if (res.ok) {
      localStorage.removeItem(STORAGE_KEY);
      status.textContent = '保存成功';
      status.className = 'status ok';
    } else {
      const err = await res.json().catch(() => ({}));
      status.textContent = '保存失败：' + (err.error || '');
      status.className = 'status err';
    }
  });
</script>
