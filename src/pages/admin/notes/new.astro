---
import Admin from '../../../layouts/Admin.astro';
---

<Admin title="写笔记">
  <div class="hd">
    <div>
      <h1>写笔记</h1>
      <p>内容支持 Markdown；离开页面前草稿会自动存在本地</p>
    </div>
  </div>

  <div class="card card-pad">
    <div class="fg">
      <label for="title">标题</label>
      <input type="text" id="title" placeholder="笔记标题">
    </div>

    <div class="fg">
      <label for="type">类型</label>
      <select id="type">
        <option value="note">笔记</option>
        <option value="hobby">爱好</option>
        <option value="quote">拾句</option>
        <option value="project">项目</option>
      </select>
    </div>

    <div class="fg">
      <label for="image">封面图片路径</label>
      <input type="text" id="image" placeholder="/photos/xxx.jpg">
      <div class="hint">图片放进 public/photos/ 后填路径，爱好与项目会用到</div>
    </div>

    <div class="fg">
      <label for="course">课程分类</label>
      <div class="row-2">
        <select id="course">
          <option value="">无分类</option>
          <option value="__new__">＋ 新建分类…</option>
        </select>
        <input type="text" id="newCourse" placeholder="新分类名" style="display:none">
      </div>
    </div>

    <div class="fg">
      <label for="content">
        内容（Markdown）
        <span class="label-action" id="togglePreview">预览</span>
      </label>
      <textarea id="content" placeholder="用 Markdown 写笔记…"></textarea>
      <div id="preview" class="preview-pane" style="display:none"></div>
    </div>

    <div class="fg">
      <label for="tags">标签</label>
      <input type="text" id="tags" placeholder="逗号分隔，例：操作系统, 进程管理">
    </div>

    <div class="actions">
      <button class="btn btn-pri" id="saveBtn">发布</button>
      <a href="/admin/notes" class="btn btn-sec">取消</a>
      <span class="status" id="status"></span>
    </div>
  </div>
</Admin>

<script>
  const STORAGE_KEY = 'note_draft_new';
  const AUTO_FIELDS = ['title', 'content', 'tags', 'image'];
  let saveTimer = null;

  const $ = (id) => document.getElementById(id);

  function saveDraft() {
    const draft = {};
    AUTO_FIELDS.forEach((f) => {
      const el = $(f);
      draft[f] = el ? el.value : '';
    });
    const courseEl = $('course');
    let courseVal = courseEl ? courseEl.value : '';
    if (courseVal === '__new__') courseVal = 'new:' + ($('newCourse').value || '');
    draft.course = courseVal;
    draft.type = ($('type') || {}).value || 'note';

    localStorage.setItem(STORAGE_KEY, JSON.stringify(draft));
    const st = $('status');
    const now = new Date();
    st.textContent = '草稿已保存 ' + now.getHours() + ':' + String(now.getMinutes()).padStart(2, '0');
    st.className = 'status';
  }

  function onDraftInput() {
    clearTimeout(saveTimer);
    saveTimer = setTimeout(saveDraft, 2000);
  }

  function tryRestoreDraft() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const draft = JSON.parse(raw);
      if (!draft.title && !draft.content) return;
      if (!confirm('检测到未发布的草稿，是否恢复？\n（点“取消”将丢弃草稿）')) {
        localStorage.removeItem(STORAGE_KEY);
        return;
      }
      AUTO_FIELDS.forEach((f) => {
        const el = $(f);
        if (el && draft[f]) el.value = draft[f];
      });
      if (draft.course) {
        const sel = $('course');
        const addOption = (v) => {
          const exists = Array.from(sel.options).some((o) => o.value === v);
          if (!exists) sel.innerHTML += '<option value="' + v + '">' + v + '</option>';
        };
        if (draft.course.startsWith('new:')) {
          const nc = $('newCourse');
          nc.value = draft.course.slice(4);
          nc.style.display = 'block';
          addOption(nc.value);
          sel.value = nc.value;
        } else {
          addOption(draft.course);
          sel.value = draft.course;
        }
      }
      if (draft.image) $('image').value = draft.image;
      if (draft.type) $('type').value = draft.type;
      $('status').textContent = '草稿已恢复';
    } catch (e) { /* 草稿损坏就当没有 */ }
  }

  AUTO_FIELDS.forEach((f) => {
    const el = $(f);
    if (el) el.addEventListener('input', onDraftInput);
  });

  fetch('/api/notes?limit=1')
    .then((r) => r.json())
    .then((data) => {
      const sel = $('course');
      const newOpt = sel.querySelector('option[value="__new__"]');
      (data.courses || []).forEach((c) => {
        const o = document.createElement('option');
        o.value = c;
        o.textContent = c;
        sel.insertBefore(o, newOpt);
      });
      tryRestoreDraft();
    })
    .catch(() => { /* 课程列表拿不到不影响写作 */ });

  $('course').addEventListener('change', function () {
    const nc = $('newCourse');
    if (this.value === '__new__') { nc.style.display = 'block'; nc.focus(); }
    else { nc.style.display = 'none'; }
    onDraftInput();
  });
  $('newCourse').addEventListener('input', onDraftInput);

  $('togglePreview').addEventListener('click', function () {
    const preview = $('preview');
    const textarea = $('content');
    if (preview.style.display === 'block') {
      preview.style.display = 'none';
      textarea.style.display = 'block';
      this.textContent = '预览';
    } else {
      preview.innerHTML = md2html(textarea.value);
      preview.style.display = 'block';
      textarea.style.display = 'none';
      this.textContent = '编辑';
    }
  });

  function md2html(md) {
    return md
      .replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/```(\w*)\n([\s\S]*?)```/g, '<pre><code>$2</code></pre>')
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/^### (.+)$/gm, '<h3>$1</h3>')
      .replace(/^## (.+)$/gm, '<h2>$1</h2>')
      .replace(/^# (.+)$/gm, '<h1>$1</h1>')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
      .replace(/^- (.+)$/gm, '<li>$1</li>')
      .replace(/\n\n/g, '</p><p>')
      .replace(/\n/g, '<br>');
  }

  $('saveBtn').addEventListener('click', async () => {
    const status = $('status');
    const title = $('title').value.trim();
    if (!title) {
      status.textContent = '标题不能为空';
      status.className = 'status err';
      return;
    }

    let course = $('course').value;
    if (course === '__new__') course = $('newCourse').value.trim();

    const tags = $('tags').value.split(',').map((t) => t.trim()).filter(Boolean);
    const imageVal = $('image').value.trim();

    status.textContent = '保存中…';
    status.className = 'status';

    const res = await fetch('/api/notes', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({
        title,
        content: $('content').value,
        course,
        tags,
        type: $('type').value,
        metadata: imageVal ? { image: imageVal } : {},
      }),
    });

    if (res.ok) {
      localStorage.removeItem(STORAGE_KEY);
      status.textContent = '发布成功，正在返回…';
      status.className = 'status ok';
      setTimeout(() => { window.location.href = '/admin/notes'; }, 900);
    } else {
      const err = await res.json().catch(() => ({}));
      status.textContent = '保存失败：' + (err.error || '');
      status.className = 'status err';
    }
  });
</script>
