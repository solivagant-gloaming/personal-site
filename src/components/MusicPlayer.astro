---
// 网易云音乐播放器组件
// - 歌单卡：放在爱好页网格里，显示歌单封面 / 名称 / 曲数 / 播放按钮
// - 点击卡片 → 播放器弹层：曲目列表 + LRC 歌词字幕同步 + 进度条 + 上下首
// - VIP 歌曲降级：标 VIP 徽标，直链获取失败时跳转网易云
//
// 数据流：
//   /api/music/playlist  → 歌单信息 + 全部曲目（含封面 / 时长 / fee）
//   /api/music/url?id=X  → 音频直链（服务端 weapi + cookie，绝不过前端）
//   /api/music/lyric?id=X→ LRC 歌词原文
//
// 注意：本组件几乎全部是动态创建的元素，样式必须用 <style is:global>
//       + .mp- 前缀隔离 —— Astro scoped style 只对模板静态元素生效，
//       动态 DOM 没有 data-astro-cid 属性，scoped 规则匹配不到。
---

<div class="mp-root" data-music-player>

  <!-- 歌单卡（嵌在爱好页，紧凑横向条） -->
  <div class="mp-card" data-mp-card data-reveal role="button" tabindex="0" aria-label="打开音乐播放器">
    <div class="mp-card-art"><img data-mp-card-cover alt="" /></div>
    <div class="mp-card-mask">
      <div class="mp-card-title" data-mp-card-title>我的音乐</div>
      <div class="mp-card-sub" data-mp-card-sub>加载中…</div>
      <button class="mp-card-play" data-mp-card-play aria-label="播放全部">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 20 12 6 21 6 3" fill="currentColor" stroke="none"/></svg>
        <span>播放全部</span>
      </button>
    </div>
  </div>

  <!-- 播放器弹层 -->
  <div class="mp-overlay" data-mp-overlay aria-hidden="true">
    <div class="mp-panel">
      <header class="mp-head">
        <div class="mp-art" data-mp-art><img data-mp-cover alt="" /></div>
        <div class="mp-meta">
          <h3 data-mp-title></h3>
          <p data-mp-artist></p>
          <span class="mp-vip-tag" data-mp-vip hidden>VIP</span>
        </div>
        <button class="mp-close" data-mp-close aria-label="关闭播放器">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </header>

      <div class="mp-body">
        <div class="mp-lyric" data-mp-lyric></div>
        <div class="mp-list" data-mp-list></div>
      </div>

      <footer class="mp-controls">
        <div class="mp-progress">
          <span class="mp-time" data-mp-cur>00:00</span>
          <div class="mp-bar" data-mp-bar><div class="mp-bar-fill" data-mp-fill></div></div>
          <span class="mp-time" data-mp-dur>00:00</span>
        </div>
        <div class="mp-btns">
          <button class="mp-btn mp-mode" data-mp-mode data-mode="order" aria-label="播放模式：顺序播放" title="顺序播放">
            <svg class="mp-mc-repeat" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
            <svg class="mp-mc-repeat1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/><text x="12" y="15.5" font-size="9.5" font-weight="700" text-anchor="middle" fill="currentColor">1</text></svg>
            <svg class="mp-mc-shuffle" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>
          </button>
          <button class="mp-btn" data-mp-prev aria-label="上一首">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="19 20 9 12 19 4 19 20"/><rect x="4" y="4" width="3" height="16" rx="1"/></svg>
          </button>
          <button class="mp-toggle" data-mp-toggle aria-label="播放/暂停">
            <svg class="mp-ic-play" width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><polygon points="7 4 20 12 7 20 7 4"/></svg>
            <svg class="mp-ic-pause" width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" rx="1.2"/><rect x="14" y="4" width="4" height="16" rx="1.2"/></svg>
          </button>
          <button class="mp-btn" data-mp-next aria-label="下一首">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 20 15 12 5 4 5 20"/><rect x="17" y="4" width="3" height="16" rx="1"/></svg>
          </button>
        </div>
      </footer>
    </div>
  </div>
</div>

<script>
document.addEventListener('astro:page-load', initMusicPlayer);
document.addEventListener('DOMContentLoaded', initMusicPlayer);
function initMusicPlayer() {
  const root = document.querySelector('[data-music-player]');
  if (!root || root.dataset.mpInited) return;
  root.dataset.mpInited = 'true';

  // ---- DOM refs ----
  const $ = (sel) => root.querySelector(sel);
  const card = $('[data-mp-card]');
  const overlay = $('[data-mp-overlay]');
  const panel = $('.mp-panel');
  const lyricEl = $('[data-mp-lyric]');
  const listEl = $('[data-mp-list]');
  const bar = $('[data-mp-bar]');
  const fill = $('[data-mp-fill]');
  const curEl = $('[data-mp-cur]');
  const durEl = $('[data-mp-dur]');
  const titleEl = $('[data-mp-title]');
  const artistEl = $('[data-mp-artist]');
  const coverEl = $('[data-mp-cover]');
  const cardCover = $('[data-mp-card-cover]');
  const cardTitle = $('[data-mp-card-title]');
  const cardSub = $('[data-mp-card-sub]');
  const vipEl = $('[data-mp-vip]');
  const toggle = $('[data-mp-toggle]');
  const prevBtn = $('[data-mp-prev]');
  const nextBtn = $('[data-mp-next]');
  const modeBtn = $('[data-mp-mode]');
  const closeBtn = $('[data-mp-close]');
  const art = $('[data-mp-art]');

  // ---- state ----
  let tracks = [];
  let cur = -1;          // 当前曲目在 tracks 中的下标
  let urlCache = new Map();
  let lrc = [];          // [{ t, text }]
  let lrcRows = [];      // 歌词 DOM 行
  let dragging = false;
  let loading = false;
  // 播放模式：order 顺序循环 / loop-one 单曲循环 / shuffle 随机播放
  const MODES = ['order', 'loop-one', 'shuffle'];
  const MODE_TIPS = { 'order': '顺序播放', 'loop-one': '单曲循环', 'shuffle': '随机播放' };
  let mode = 'order';
  const audio = new Audio();
  audio.preload = 'none';

  // ---- 播放模式 ----
  function setMode(m) {
    mode = m;
    modeBtn.dataset.mode = m;
    modeBtn.setAttribute('aria-label', '播放模式：' + MODE_TIPS[m]);
    modeBtn.title = MODE_TIPS[m];
    // 单曲循环由 audio.loop 兜底（end 事件不会再触发）
    audio.loop = (m === 'loop-one');
  }
  modeBtn.addEventListener('click', () => {
    const i = MODES.indexOf(mode);
    setMode(MODES[(i + 1) % MODES.length]);
  });

  // ---- 工具 ----
  const fmt = (sec) => {
    if (!isFinite(sec) || sec < 0) sec = 0;
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
  };
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const isVip = (t) => t.fee === 1 || t.fee === 8;

  // ---- 歌单加载 ----
  async function loadPlaylist() {
    if (loading) return;
    loading = true;
    cardSub.textContent = '加载中…';
    try {
      const res = await fetch('/api/music/playlist');
      const data = await res.json();
      if (!res.ok || !data.tracks) throw new Error(data.error || '歌单加载失败');
      tracks = data.tracks;
      cardTitle.textContent = data.name || '我的音乐';
      cardSub.textContent = data.count + ' 首';
      if (data.cover) { cardCover.src = data.cover; cardCover.style.display = ''; }
      renderList();
    } catch (e) {
      cardSub.textContent = '加载失败，点击重试';
      console.warn('[music] playlist:', e.message);
    } finally {
      loading = false;
    }
  }

  // ---- 曲目列表 ----
  function renderList() {
    listEl.textContent = '';
    const frag = document.createDocumentFragment();
    tracks.forEach((t, i) => {
      const row = document.createElement('div');
      row.className = 'mp-li';
      row.dataset.i = i;
      row.innerHTML = `
        <span class="mp-li-idx">${isVip(t) ? '<i class="mp-vip-dot">V</i>' : String(i + 1).padStart(2, '0')}</span>
        <span class="mp-li-main">
          <span class="mp-li-name">${esc(t.name)}</span>
          <span class="mp-li-artist">${esc(t.artist)}</span>
        </span>
        <span class="mp-li-dur">${fmt((t.duration || 0) / 1000)}</span>`;
      row.addEventListener('click', () => playTrack(i));
      frag.appendChild(row);
    });
    listEl.appendChild(frag);
  }

  // ---- 弹层开关 ----
  function openPlayer(autoPlay = true) {
    if (tracks.length === 0) { loadPlaylist(); return; } // 歌单未就绪（加载中/失败），先加载
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    if (cur < 0) playTrack(0, autoPlay);
    else if (autoPlay && audio.paused) audio.play().catch(() => {});
  }
  function closePlayer() {
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // ---- 播放逻辑 ----
  async function playTrack(i, shouldPlay = true) {
    if (i < 0 || i >= tracks.length) return;
    const t = tracks[i];
    cur = i;
    // 更新 UI
    titleEl.textContent = t.name;
    artistEl.textContent = t.artist;
    vipEl.hidden = !isVip(t);
    if (t.cover) { coverEl.src = t.cover; art.classList.add('has-cover'); }
    listEl.querySelectorAll('.mp-li').forEach((row, idx) => {
      row.classList.toggle('active', idx === i);
      row.classList.toggle('playing', idx === i);
    });
    cardSub.textContent = '正在播放：' + t.name;

    // 歌词
    loadLyric(t.id);
    resetProgress();

    // 直链 + 播放
    if (!shouldPlay) return;
    let url = urlCache.get(t.id);
    if (!url) {
      try {
        const res = await fetch('/api/music/url?id=' + encodeURIComponent(t.id));
        const data = await res.json();
        url = data.url || null;
        urlCache.set(t.id, url);
      } catch (e) {
        url = null;
      }
    }
    if (!url) {
      // VIP 降级：无权限直链
      audio.pause();
      setPlaying(false);
      showVipFallback(t);
      return;
    }
    audio.src = url;
    try { await audio.play(); setPlaying(true); }
    catch (e) { setPlaying(false); }
  }

  function setPlaying(playing) {
    root.classList.toggle('mp-playing', playing);
    toggle.classList.toggle('playing', playing);
  }

  function showVipFallback(t) {
    // 在歌词区提示，并给出网易云跳转
    lyricEl.textContent = '';
    const box = document.createElement('div');
    box.className = 'mp-lrc-empty';
    box.innerHTML = `
      <div class="mp-vip-icon">★</div>
      <p>这首 <b>${esc(t.name)}</b> 暂时无法播放</p>
      <p class="mp-sub">可能需会员或登录已过期</p>
      <a class="mp-vip-go" href="https://music.163.com/#/song?id=${t.id}" target="_blank" rel="noopener">去网易云收听 →</a>`;
    lyricEl.appendChild(box);
  }

  function togglePlay() {
    if (cur < 0) return;
    if (audio.paused) audio.play().then(() => setPlaying(true)).catch(() => {});
    else { audio.pause(); setPlaying(false); }
  }
  function pickNext(delta) {
    const len = tracks.length;
    if (mode === 'shuffle') {
      if (len <= 1) return cur;
      // 随机但避免原地重播
      let i;
      do { i = Math.floor(Math.random() * len); } while (i === cur);
      return i;
    }
    return (cur + delta + len) % len;
  }
  function step(delta) {
    if (tracks.length === 0) return;
    playTrack(pickNext(delta));
  }

  // ---- 进度 ----
  function resetProgress() {
    curEl.textContent = '00:00';
    durEl.textContent = fmt((tracks[cur]?.duration || 0) / 1000);
    fill.style.width = '0%';
  }
  function updateProgress() {
    if (dragging || !audio.duration) return;
    const pct = (audio.currentTime / audio.duration) * 100;
    fill.style.width = pct + '%';
    curEl.textContent = fmt(audio.currentTime);
  }
  function seekFromEvent(e) {
    const rect = bar.getBoundingClientRect();
    const ratio = Math.min(Math.max((e.clientX - rect.left) / rect.width, 0), 1);
    if (audio.duration) { audio.currentTime = ratio * audio.duration; updateProgress(); }
    else fill.style.width = (ratio * 100) + '%';
  }

  // ---- 歌词 ----
  function parseLrc(text) {
    const out = [];
    const lineRe = /\[(\d{1,2}):(\d{1,2})(?:[.:](\d{1,3}))?\]/g;
    for (const raw of String(text || '').split('\n')) {
      const times = [];
      let m;
      lineRe.lastIndex = 0;
      while ((m = lineRe.exec(raw)) !== null) {
        times.push(parseInt(m[1], 10) * 60 + parseInt(m[2], 10) + (m[3] ? parseInt(m[3].padEnd(3, '0'), 10) / 1000 : 0));
      }
      const content = raw.replace(lineRe, '').trim();
      if (!content) continue;
      for (const t of times) out.push({ t, text: content });
    }
    out.sort((a, b) => a.t - b.t);
    return out;
  }
  async function loadLyric(id) {
    lrc = [];
    lrcRows = [];
    lyricEl.textContent = '';
    lyricEl.innerHTML = '<div class="mp-lrc-loading">歌词加载中…</div>';
    try {
      const res = await fetch('/api/music/lyric?id=' + encodeURIComponent(id));
      const data = await res.json();
      const parsed = parseLrc(data.lrc);
      if (!parsed.length) { showNoLyric(); return; }
      lrc = parsed;
      const frag = document.createDocumentFragment();
      parsed.forEach((line, i) => {
        const d = document.createElement('div');
        d.className = 'mp-lrow';
        d.textContent = line.text;
        d.dataset.i = i;
        frag.appendChild(d);
      });
      lyricEl.textContent = '';
      lyricEl.appendChild(frag);
      lrcRows = [...lyricEl.querySelectorAll('.mp-lrow')];
    } catch (e) {
      showNoLyric();
    }
  }
  function showNoLyric() {
    lyricEl.textContent = '';
    const d = document.createElement('div');
    d.className = 'mp-lrc-empty';
    d.innerHTML = '<div class="mp-note">♪</div><p>暂无歌词<br/><span class="mp-sub">纯音乐或未提供歌词</span></p>';
    lyricEl.appendChild(d);
  }
  function syncLyric() {
    if (!lrc.length) return;
    const t = audio.currentTime;
    // 找到最后一行 t <= 当前时间的行
    let idx = -1;
    for (let i = 0; i < lrc.length; i++) {
      if (lrc[i].t <= t) idx = i;
      else break;
    }
    lrcRows.forEach((row, i) => row.classList.toggle('active', i === idx));
    if (idx >= 0 && lrcRows[idx]) {
      const row = lrcRows[idx];
      const rect = row.getBoundingClientRect();
      const cont = lyricEl.getBoundingClientRect();
      if (rect.top < cont.top || rect.bottom > cont.bottom) {
        row.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }
    }
  }

  // ---- 事件绑定 ----
  card.addEventListener('click', (e) => {
    if (e.target.closest('[data-mp-card-play]')) return; // 播放按钮单独处理
    openPlayer();
  });
  card.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openPlayer(); }
  });
  $('[data-mp-card-play]').addEventListener('click', (e) => {
    e.stopPropagation();
    openPlayer(true);
  });
  closeBtn.addEventListener('click', closePlayer);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closePlayer(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('open')) closePlayer();
  });

  toggle.addEventListener('click', togglePlay);
  prevBtn.addEventListener('click', () => step(-1));
  nextBtn.addEventListener('click', () => step(1));

  bar.addEventListener('pointerdown', (e) => {
    dragging = true;
    seekFromEvent(e);
    bar.setPointerCapture(e.pointerId);
  });
  bar.addEventListener('pointermove', (e) => { if (dragging) seekFromEvent(e); });
  bar.addEventListener('pointerup', () => { dragging = false; });

  audio.addEventListener('timeupdate', () => { updateProgress(); syncLyric(); });
  audio.addEventListener('loadedmetadata', () => {
    durEl.textContent = fmt(audio.duration);
    updateProgress();
  });
  audio.addEventListener('ended', () => {
    if (mode === 'loop-one') return; // audio.loop 已接管单曲循环
    step(1);
  });
  audio.addEventListener('play', () => setPlaying(true));
  audio.addEventListener('pause', () => setPlaying(false));
  audio.addEventListener('error', () => {
    if (cur >= 0) { setPlaying(false); showNoLyric(); }
  });

  // 初始化
  loadPlaylist();
}
</script>

<style is:global>
/* ── 根容器：不占 grid cell，让 .mp-card 直接成为网格项（避免空壳占位导致卡片错位） ── */
.mp-root { display: contents; }

/* ── 歌单卡（横向紧凑条：封面缩略图 + 名称/曲数 + 播放按钮） ── */
.mp-card {
  display: flex; align-items: center; gap: 1rem;
  padding: 0.8rem 1.1rem;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-left: 3px solid var(--c-os);
  border-radius: var(--radius);
  cursor: pointer;
  transition: box-shadow 0.2s, transform 0.2s;
}
.mp-card:hover { box-shadow: var(--shadow-hover); transform: translateY(-2px); }
.mp-card-art {
  width: 56px; height: 56px; border-radius: 8px; overflow: hidden; flex-shrink: 0;
  background: var(--bg-hover);
}
.mp-card-art img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: transform 0.5s ease;
}
.mp-card:hover .mp-card-art img { transform: scale(1.06); }
.mp-card-mask { flex: 1; min-width: 0; }
.mp-card-title {
  font-size: 1rem; font-weight: 700; margin: 0 0 0.15rem;
  color: var(--text);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.mp-card-sub {
  font-size: 0.75rem; margin: 0; color: var(--text-secondary);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.mp-card-play {
  flex-shrink: 0;
  display: inline-flex; align-items: center; gap: 0.35rem;
  background: linear-gradient(135deg, var(--c-os), #a78bfa);
  border: none; color: #fff; font-size: 0.75rem; font-weight: 600;
  padding: 0.4rem 0.9rem; border-radius: 999px; cursor: pointer;
  transition: opacity 0.15s, transform 0.15s;
}
.mp-card-play:hover { opacity: 0.9; transform: scale(1.04); }

/* ── 弹层 ── */
.mp-overlay {
  position: fixed; inset: 0; z-index: 980;
  background: rgba(5, 8, 15, 0.72);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  display: flex; align-items: center; justify-content: center;
  opacity: 0; visibility: hidden; pointer-events: none;
  transition: opacity 0.25s, visibility 0.25s;
}
.mp-overlay.open { opacity: 1; visibility: visible; pointer-events: auto; }
.mp-panel {
  width: min(780px, calc(100vw - 2rem));
  max-height: min(88vh, 640px);
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 16px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  display: flex; flex-direction: column;
  overflow: hidden;
  transform: translateY(12px) scale(0.98);
  transition: transform 0.25s;
}
.mp-overlay.open .mp-panel { transform: translateY(0) scale(1); }

.mp-head {
  display: flex; align-items: center; gap: 0.9rem;
  padding: 1rem 1.2rem;
  border-bottom: 1px solid var(--border);
  background: var(--bg);
}
.mp-art {
  width: 56px; height: 56px; border-radius: 10px; overflow: hidden; flex-shrink: 0;
  background: var(--bg-hover);
}
.mp-art img { width: 100%; height: 100%; object-fit: cover; display: block; }
.mp-art.has-cover img { animation: mp-spin 12s linear infinite; }
.mp-root.mp-playing .mp-art.has-cover img { animation-play-state: running; }
.mp-art.has-cover img { animation-play-state: paused; }
@keyframes mp-spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }
.mp-meta { flex: 1; min-width: 0; }
.mp-meta h3 { font-size: 1.05rem; font-weight: 600; margin: 0 0 0.2rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
