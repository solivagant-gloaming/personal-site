---
// 星空穹顶 — Three.js 球壳星场（有纵深 + 单星闪烁 + 鼠标视差）
---
<div id="starfield3d" aria-hidden="true"></div>

<script>
  import * as THREE from 'three';

  (() => {
    const container = document.getElementById('starfield3d');
    if (!container) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.matchMedia('(max-width: 768px)').matches;

    let renderer;
    try {
      renderer = new THREE.WebGLRenderer({ antialias: false, alpha: true, powerPreference: 'low-power' });
    } catch {
      return; // WebGL 不可用，安静退出
    }
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setClearColor(0x000000, 0);
    container.appendChild(renderer.domElement);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(62, window.innerWidth / window.innerHeight, 1, 4000);
    camera.position.set(0, 0, 0);

    // ── 星场 ──
    const COUNT = isMobile ? 1400 : 2800;
    const positions = new Float32Array(COUNT * 3);
    const colors = new Float32Array(COUNT * 3);
    const sizes = new Float32Array(COUNT);
    const phases = new Float32Array(COUNT);

    // 色温：蓝白 / 白 / 淡黄 / 微橙
    const TINTS = [
      [0.78, 0.86, 1.00],
      [0.95, 0.97, 1.00],
      [1.00, 0.96, 0.86],
      [1.00, 0.86, 0.74],
    ];

    for (let i = 0; i < COUNT; i++) {
      const u = Math.random() * 2 - 1;
      const theta = Math.random() * Math.PI * 2;
      const r = 420 + Math.random() * 980;          // 球壳：近远交织 → 纵深
      const s = Math.sqrt(1 - u * u);

      positions[i * 3]     = r * s * Math.cos(theta);
      positions[i * 3 + 1] = r * s * Math.sin(theta);
      positions[i * 3 + 2] = r * u;

      const pick = Math.random();
      const c = pick < 0.48 ? TINTS[0] : pick < 0.80 ? TINTS[1] : pick < 0.94 ? TINTS[2] : TINTS[3];
      const b = 0.55 + Math.random() * 0.45;
      colors[i * 3]     = c[0] * b;
      colors[i * 3 + 1] = c[1] * b;
      colors[i * 3 + 2] = c[2] * b;

      sizes[i]  = 1.0 + Math.pow(Math.random(), 3.2) * 4.8;   // 少量亮星
      phases[i] = Math.random() * Math.PI * 2;
    }

    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geo.setAttribute('aColor', new THREE.BufferAttribute(colors, 3));
    geo.setAttribute('aSize', new THREE.BufferAttribute(sizes, 1));
    geo.setAttribute('aPhase', new THREE.BufferAttribute(phases, 1));

    const mat = new THREE.ShaderMaterial({
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      uniforms: {
        uTime: { value: 0 },
        uDpr: { value: renderer.getPixelRatio() },
      },
      vertexShader: `
        attribute float aSize;
        attribute float aPhase;
        attribute vec3 aColor;
        uniform float uTime;
        uniform float uDpr;
        varying vec3 vColor;
        varying float vTw;
        void main() {
          vColor = aColor;
          vTw = 0.55 + 0.45 * sin(uTime * 1.35 + aPhase);
          vec4 mv = modelViewMatrix * vec4(position, 1.0);
          gl_PointSize = aSize * uDpr * (430.0 / -mv.z);
          gl_Position = projectionMatrix * mv;
        }
      `,
      fragmentShader: `
        varying vec3 vColor;
        varying float vTw;
        void main() {
          vec2 uv = gl_PointCoord - 0.5;
          float d = length(uv);
          if (d > 0.5) discard;
          float core = smoothstep(0.5, 0.04, d);
          float glow = smoothstep(0.5, 0.0, d);
          vec3 col = vColor * (0.80 * core + 0.42 * glow);
          gl_FragColor = vec4(col * vTw, (core + glow * 0.45) * vTw);
        }
      `,
    });

    const stars = new THREE.Points(geo, mat);
    scene.add(stars);

    // ── 鼠标视差 ──
    const target = { x: 0, y: 0 };
    window.addEventListener('pointermove', (e) => {
      target.x = (e.clientX / window.innerWidth - 0.5) * 2;
      target.y = (e.clientY / window.innerHeight - 0.5) * 2;
    }, { passive: true });

    // ── 渲染循环 ──
    const clock = new THREE.Clock();
    let rx = 0, ry = 0, raf = 0;

    function animate() {
      raf = requestAnimationFrame(animate);
      const t = clock.getElapsedTime();
      mat.uniforms.uTime.value = t;

      rx += (target.y * 0.22 - rx) * 0.045;
      ry += (target.x * 0.22 - ry) * 0.045;

      stars.rotation.y = t * 0.009 + ry;
      stars.rotation.x = rx;

      renderer.render(scene, camera);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else { clock.start(); animate(); }
    });

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      mat.uniforms.uDpr.value = renderer.getPixelRatio();
    });

    if (reduceMotion) renderer.render(scene, camera);
    else animate();
  })();
</script>

<style>
  #starfield3d {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  #starfield3d canvas { display: block; }
</style>
