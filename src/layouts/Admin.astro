---
/**
 * 后台共享外壳。
 *
 * 五个后台页面此前各自复制了一份 HTML 骨架 + 一份内联样式，既容易走样又要改五处，
 * 还因为 Astro 的 scoped 样式匹配不到 JS 动态插入的节点而整片失效。
 * 这里收成唯一一份：侧栏、导航、待审徽标、退出登录都在这一处。
 *
 * 登录门禁在 src/middleware.ts —— 布局是渲染期组件，那时响应流已经开了，
 * 在这里重定向会抛 ResponseSentError。
 */
import '../styles/admin.css';

export interface Props {
  /** 页面标题，同时用于 <title> */
  title: string;
  /** 主区宽度：wide 给内容管理这种分栏页 */
  width?: 'narrow' | 'wide';
}

const { title, width = 'narrow' } = Astro.props;

const path = Astro.url.pathname;
const NAV = [
  { href: '/admin', label: '概览', icon: '◈' },
  { href: '/admin/notes', label: '内容', icon: '▤' },
  { href: '/admin/quotes', label: '投稿审核', icon: '✦', badge: true },
];
const isActive = (href: string) =>
  href === '/admin' ? path === '/admin' : path.startsWith(href);
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>{title} — 管理后台</title>
</head>
<body>
  <div class="layout">
    <aside class="side">
      <div class="side-logo">
        <div class="side-mark">S</div>
        <div>
          <b>Solivagant</b>
          <span>内容管理后台</span>
        </div>
      </div>

      <nav class="side-nav">
        <div class="nav-label">工作台</div>
        {NAV.map((item) => (
          <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
            <span class="ic">{item.icon}</span>
            <span>{item.label}</span>
            {item.badge && <span class="badge" id="pendingBadge" hidden></span>}
          </a>
        ))}
      </nav>

      <div class="side-foot">
        <a href="/" target="_blank" rel="noopener">↗ 查看网站</a>
        <button type="button" id="logoutBtn">⏻ 退出登录</button>
      </div>
    </aside>

    <main class={`main ${width === 'wide' ? 'main-wide' : 'main-narrow'}`}>
      <slot />
    </main>
  </div>

  <script>
    // ── 待审徽标：0 条时不显示，免得没投稿也占视线 ──
    (function () {
      const badge = document.getElementById('pendingBadge');
      if (!badge) return;
      fetch('/api/admin/pending-count', { credentials: 'same-origin' })
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          const n = d && d.pending;
          if (!n) return;
          badge.textContent = n > 99 ? '99+' : String(n);
          badge.title = n + ' 句待审';
          badge.hidden = false;
        })
        .catch(() => { /* 徽标拿不到就算了，不能拖累页面本身 */ });
    })();

    // ── 退出登录 ──
    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      if (!confirm('确定退出管理后台？')) return;
      await fetch('/api/admin/logout', { method: 'POST' });
      window.location.href = '/admin/login';
    });
  </script>
</body>
</html>
